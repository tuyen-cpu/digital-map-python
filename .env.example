# Sao chép file này thành .env và điền giá trị thực tế

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=binh_dinh_tourism
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Admin account cứng (không lưu DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BinhDinh@2026
ADMIN_DISPLAY_NAME=Quản trị viên Bình Định

# Password reset default
DEFAULT_RESET_PASSWORD=PhuongBinhDinh@123

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=binh-dinh-tourism
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
# Hoặc custom domain: https://media.yourdomain.com

# CORS - Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
